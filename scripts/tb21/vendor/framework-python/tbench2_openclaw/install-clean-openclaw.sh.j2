#!/bin/bash
set -euo pipefail

OPENCLAW_VERSION="{{ version | default('2026.3.11') }}"
NODE_VERSION="${OPENCLAW_NODE_VERSION:-22.22.1}"
NPM_REGISTRY="${NPM_CONFIG_REGISTRY:-https://registry.npmmirror.com}"
NODE_MIRROR="${OPENCLAW_NODE_MIRROR:-https://npmmirror.com/mirrors/node}"
DEBIAN_MIRROR="${TBENCH_DEBIAN_MIRROR:-http://mirrors.tuna.tsinghua.edu.cn/debian}"
DEBIAN_SECURITY_MIRROR="${TBENCH_DEBIAN_SECURITY_MIRROR:-http://mirrors.tuna.tsinghua.edu.cn/debian-security}"

rewrite_debian_sources() {
  if [ ! -f /etc/os-release ] || ! grep -q '^ID=debian' /etc/os-release; then
    return
  fi

  if [ -f /etc/apt/sources.list.d/debian.sources ]; then
    sed -i \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources
  fi
  if [ -f /etc/apt/sources.list ]; then
    sed -i \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      /etc/apt/sources.list
  fi
}

install_debian_deps() {
  if ! command -v apt-get >/dev/null 2>&1; then
    return
  fi

  rewrite_debian_sources
  apt-get update -qq
  apt-get install -y --no-install-recommends ca-certificates curl git xz-utils
  rm -rf /var/lib/apt/lists/*
}

if [ -x /opt/openclaw-runtime/bin/openclaw ] && [ -x /opt/openclaw-runtime/bin/node ]; then
  echo "Using mounted OpenClaw runtime"
  rewrite_debian_sources
  ln -sf /opt/openclaw-runtime/bin/node /usr/local/bin/node
  ln -sf /opt/openclaw-runtime/bin/openclaw /usr/local/bin/openclaw
  mkdir -p /logs/agent/empty-skills
  openclaw --version
  exit 0
fi

if [ -f /installed-agent/openclaw-node-bundle.tgz ]; then
  echo "Using bundled OpenClaw runtime"
  tar -xzf /installed-agent/openclaw-node-bundle.tgz -C /
  chmod +x /usr/local/bin/node /usr/local/bin/openclaw
  mkdir -p /logs/agent/empty-skills
  openclaw --version
  exit 0
fi

if ! command -v curl >/dev/null 2>&1 || ! command -v git >/dev/null 2>&1; then
  install_debian_deps
fi

if [ -f /app/openclaw.mjs ] && ! command -v openclaw >/dev/null 2>&1; then
  printf '#!/bin/sh\nexec node /app/openclaw.mjs "$@"\n' > /usr/local/bin/openclaw
  chmod +x /usr/local/bin/openclaw
fi

node_major=0
if command -v node >/dev/null 2>&1; then
  node_major="$(node --version | sed 's/v//' | cut -d. -f1)"
fi

if [ "$node_major" -lt 22 ]; then
  if ! command -v apt-get >/dev/null 2>&1; then
    echo "Error: Node.js >= 22 required and apt-get is unavailable" >&2
    exit 1
  fi
  install_debian_deps

  arch="$(uname -m)"
  case "$arch" in
    x86_64|amd64) node_arch="x64" ;;
    aarch64|arm64) node_arch="arm64" ;;
    *) echo "Unsupported architecture for Node.js binary install: $arch" >&2; exit 1 ;;
  esac

  node_dir="/opt/node-v${NODE_VERSION}"
  node_tar="/tmp/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"
  curl -fsSL "${NODE_MIRROR}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o "$node_tar"
  mkdir -p "$node_dir"
  tar -xJf "$node_tar" -C "$node_dir" --strip-components=1
  ln -sf "$node_dir/bin/node" /usr/local/bin/node
  ln -sf "$node_dir/bin/npm" /usr/local/bin/npm
  ln -sf "$node_dir/bin/npx" /usr/local/bin/npx
  if [ -x "$node_dir/bin/corepack" ]; then
    ln -sf "$node_dir/bin/corepack" /usr/local/bin/corepack
  fi
  rm -f "$node_tar"
fi

if command -v openclaw >/dev/null 2>&1; then
  installed_version="$(openclaw --version 2>/dev/null || true)"
  if printf '%s\n' "$installed_version" | grep -q "OpenClaw ${OPENCLAW_VERSION}"; then
    echo "$installed_version"
    exit 0
  fi
fi

npm config set registry "$NPM_REGISTRY"
npm config set audit false
npm config set fund false
npm install -g --legacy-peer-deps "openclaw@${OPENCLAW_VERSION}"
npm cache clean --force || true
rm -rf /root/.npm /tmp/node-compile-cache

mkdir -p /logs/agent/empty-skills
openclaw --version
