# TB2.1 campaign settings (source AFTER env.sh, BEFORE launching).
# Every value below is recorded per trial in manifest.tsv by recover_rolling.py.
# 2026-10-10: settings for the fixed-network reruns (not those of the first full runs).

# --- sandbox network (tencent_vpc_dns_env.TencentVpcDnsE2BEnvironment) ---
# Task sandboxes only have public DNS (1.1.1.1/8.8.8.8); the VPC DNS server makes
# mirrors.tencentyun.com resolve to the intranet mirror 169.254.0.3.
export TBENCH_VPC_DNS=183.60.83.19
# PyPI/uv through the intranet mirror (865MB torch wheel: 5s vs 0.19MB/s official).
export TBENCH_PYPI_MIRROR=https://mirrors.tencentyun.com/pypi/simple/
# Debian 11 security pool dropped the curl the index lists (404 everywhere);
# enable the task author's own snapshot.debian.org lines on bullseye images only.
export TBENCH_APT_SNAPSHOT_BULLSEYE=1
# apt via intranet mirror for non-bullseye images: off (apt was never the bottleneck,
# and turning it on changes the agent's apt environment for every task).
export TBENCH_APT_INTRANET_MIRROR=0

# --- retries and timeouts (run_tencent_tb21_smoke_niuyiming.sh) ---
# One orchestrator retry, only for AgentSetupTimeoutError / SandboxException /
# AddTestsDirError (VerifierTimeoutError is NOT retried at trial level).
export TBENCH_MAX_TRIAL_RETRIES=1
# Verifier ceiling: task.toml value overridden to 2 hours for every task.
export TBENCH_VERIFIER_OVERRIDE=7200.0
export TBENCH_SETUP_MULTIPLIER=3
