# Sourced by launchers. Loads secrets into the process env only; contains none.
#
# Since the bundle became self-contained (2026-10-10) most of this file is no
# longer needed: the runner defaults to <bundle>/secrets.env, <bundle>/.venv and
# the vendored trees.  Keep a copy of this file only for per-host overrides.

# The runner sources <bundle>/secrets.env on its own (TBENCH_TENCENT_ENV_FILE
# overrides the path).  secrets.env must define: E2B_API_KEY, E2B_DOMAIN,
# TBENCH_LLM_KEY.  The LLM key is passed to Harbor as OPENAI_API_KEY:
set -a
. "${0%/*}/secrets.env"
set +a
export OPENAI_API_KEY="${OPENAI_API_KEY_OVERRIDE:-$TBENCH_LLM_KEY}"

# --- per-host overrides (all optional; defaults are bundle-relative) ---
# Relay sandbox template name (E2B template, not a file).
export TBENCH_E2B_RELAY_TEMPLATE=code-agent-cfs2-new
# Where to read/write experiment products if not the node29 default.
# export TBENCH_RESULTS_ROOT=/data2/niuyiming
# Per-trial logs (recover_rolling.py) default to <bundle>/logs.
# export TBENCH_LOGS_DIR=...
# Use an existing venv instead of <bundle>/.venv (e.g. node29's agentbrew venv):
# export TBENCH_VENV_DIR=$HOME/agentbrew-tb21/.venv
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH=  # skillexpand is NOT imported by the eval chain; keep it out
export TBENCH_PERSIST_SANDBOXES=0
