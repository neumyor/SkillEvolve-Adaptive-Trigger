# Sourced by launchers. Loads secrets into the process env only; contains none.
_R=$HOME/niuyiming/SkillExpand-tbeval
set -a
. "$HOME/agentbrew-tb21/.env"
set +a
export OPENAI_API_KEY="${OPENAI_API_KEY_OVERRIDE:-$TBENCH_LLM_KEY}"
# 默认模型仅是占位;每次启动命令都会按 run 显式覆盖 MODEL_NAME(qwen3.6-flash-distill / DEEPSEEK_up5zdj)
export MODEL_NAME=qwen3.6-plus-distill
export TBENCH_E2B_RELAY_TEMPLATE=code-agent-cfs2-new
export TBENCH_TENCENT_ENV_FILE=/nonexistent/.env
export RETRY_ARCHIVE_ROOT=/data2/niuyiming/retry_archives
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH=$_R/repo/src
export TBENCH_PERSIST_SANDBOXES=0
export PYTHON=$_R/.venv/bin/python
# liyishan's venv python is not executable by this user (symlink into /home/liyishan);
# use this user's own Harbor venv (agentbrew-tb21). Dataset/adapter still read-only from /data2/liyishan.
export HARBOR_BIN=$HOME/agentbrew-tb21/.venv/bin/harbor
export PYTHON_BIN=$HOME/agentbrew-tb21/.venv/bin/python
